{
  "name": "C++ Dev (Custom)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=vscode-server-cache,target=/root/.vscode-server,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "ms-vscode.cmake-tools"]
    }
  },
  "remoteUser": "root"
}
